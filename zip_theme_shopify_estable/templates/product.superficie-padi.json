e-row-1","collapsible-row-3","8f261633-b622-4b41-8998-0c19ef09a999","89012cc7-fa8e-4293-ab51-62205e799e85"],"settings":{"caption":"Resumen de las:","heading":"Características de la Superficie de impresión Padi","heading_size":"h1","heading_alignment":"center","layout":"section","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"image_ratio":"adapt","desktop_layout":"image_second","padding_top":16,"padding_bottom":28}},"a04870e8-ac7e-4376-ba28-693e26790a32":{"type":"rich-text","blocks":{"template--16023189880989__a04870e8-ac7e-4376-ba28-693e26790a32-1675132947751e73e4-0":{"type":"heading","settings":{"heading":"Características de la superficie de impresión Padi","heading_size":"h1"}}},"block_order":["template--16023189880989__a04870e8-ac7e-4376-ba28-693e26790a32-1675132947751e73e4-0"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"accent-2","full_width":true,"padding_top":16,"padding_bottom":28}},"8849eaaa-f0e0-4cbe-9fa1-97396f9900d2":{"type":"image-with-text","blocks":{"template--16023189880989__8849eaaa-f0e0-4cbe-9fa1-97396f9900d2-167513290718ace14a-0":{"type":"heading","settings":{"heading":"Objetivo del Padi","heading_size":"h2"}},"template--16023189880989__8849eaaa-f0e0-4cbe-9fa1-97396f9900d2-167513290718ace14a-1":{"type":"text","settings":{"text":"<p>Los Padi son un producto diseñado para facilitarte la vida, esta hecho para que se pegue el filamento a la base y sea muy <strong>fácil de remover<\/strong>.<\/p><p>Reemplazan la cinta adhesiva azul y la laca que ocupan las otras impresoras.<\/p>","text_style":"body"}}},"block_order":["template--16023189880989__8849eaaa-f0e0-4cbe-9fa1-97396f9900d2-167513290718ace14a-0","template--16023189880989__8849eaaa-f0e0-4cbe-9fa1-97396f9900d2-167513290718ace14a-1"],"settings":{"image":"shopify:\/\/shop_images\/logo_Axis_One_cuadrado.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"3dac2969-ba90-4798-9499-5448efff0943":{"type":"image-with-text","blocks":{"template--16023189880989__3dac2969-ba90-4798-9499-5448efff0943-167513290718ace14a-0":{"type":"heading","settings":{"heading":"Fácil Adhesión","heading_size":"h2"}},"template--16023189880989__3dac2969-ba90-4798-9499-5448efff0943-167513290718ace14a-1":{"type":"text","settings":{"text":"<p>El Padi tiene una película como el polímero de la molécula de laca, la cual le otorga la propiedad de que el filamento se pegue <strong>fácilmente <\/strong>a su superficie<\/p>","text_style":"body"}}},"block_order":["template--16023189880989__3dac2969-ba90-4798-9499-5448efff0943-167513290718ace14a-0","template--16023189880989__3dac2969-ba90-4798-9499-5448efff0943-167513290718ace14a-1"],"settings":{"image":"shopify:\/\/shop_images\/222.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"82466e86-4b5e-4d4d-b6f5-0e9a3bc237f7":{"type":"image-with-text","blocks":{"template--16023189880989__82466e86-4b5e-4d4d-b6f5-0e9a3bc237f7-167513290718ace14a-0":{"type":"heading","settings":{"heading":"Despegue flexible","heading_size":"h2"}},"template--16023189880989__82466e86-4b5e-4d4d-b6f5-0e9a3bc237f7-167513290718ace14a-1":{"type":"text","settings":{"text":"<p>Las impresiones 3D se despegan muy fácil de esta superficie, solo con <strong>doblar el Padi<\/strong>.<br\/><\/p><p>Así de simple. ;)<\/p>","text_style":"body"}}},"block_order":["template--16023189880989__82466e86-4b5e-4d4d-b6f5-0e9a3bc237f7-167513290718ace14a-0","template--16023189880989__82466e86-4b5e-4d4d-b6f5-0e9a3bc23