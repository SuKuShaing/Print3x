psible-row-3","8f261633-b622-4b41-8998-0c19ef09a999","89012cc7-fa8e-4293-ab51-62205e799e85"],"settings":{"caption":"Resumen de las:","heading":"Características del la impresora 3D Profesional Axis One","heading_size":"h1","heading_alignment":"center","layout":"section","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"image_ratio":"adapt","desktop_layout":"image_second","padding_top":16,"padding_bottom":28}},"a04870e8-ac7e-4376-ba28-693e26790a32":{"type":"rich-text","blocks":{"template--16023189880989__a04870e8-ac7e-4376-ba28-693e26790a32-1675132947751e73e4-0":{"type":"heading","settings":{"heading":"Características de la Impresora 3D Profesional Axis One","heading_size":"h1"}}},"block_order":["template--16023189880989__a04870e8-ac7e-4376-ba28-693e26790a32-1675132947751e73e4-0"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"accent-2","full_width":true,"padding_top":16,"padding_bottom":28}},"daa10ced-3088-449a-a586-7dff79128c86":{"type":"video","settings":{"heading":"","heading_size":"h2","enable_video_looping":false,"video_url":"https:\/\/youtu.be\/J-rV8g_5Te4","cover_image":"shopify:\/\/shop_images\/Portada_video_Axis_One.jpg","description":"Video de presentación impresora 3D Axis One producidad por Print3x printex printec print3c","full_width":false,"color_scheme":"background-1","padding_top":16,"padding_bottom":0}},"8849eaaa-f0e0-4cbe-9fa1-97396f9900d2":{"type":"image-with-text","blocks":{"template--16023189880989__8849eaaa-f0e0-4cbe-9fa1-97396f9900d2-167513290718ace14a-0":{"type":"heading","settings":{"heading":"Objetivo","heading_size":"h2"}},"template--16023189880989__8849eaaa-f0e0-4cbe-9fa1-97396f9900d2-167513290718ace14a-1":{"type":"text","settings":{"text":"<p>La impresora 3D <strong>Axis One <\/strong>esta diseñada para que sean muy simples de usar y que entreguen una gran calidad de impresión, con su gran volumen de impresión, su velocidad, la pantalla táctil y los filamentos rígidos y flexibles que puede utilizar, queremos que tengas la mejor experiencia y resultados de gran calidad.<\/p><p>Además cuentas con <strong>todo un equipo para responder a tus dudas <\/strong>y dispones de un soporte técnico completo.<\/p>","text_style":"body"}}},"block_order":["template--16023189880989__8849eaaa-f0e0-4cbe-9fa1-97396f9900d2-167513290718ace14a-0","template--16023189880989__8849eaaa-f0e0-4cbe-9fa1-97396f9900d2-167513290718ace14a-1"],"settings":{"image":"shopify:\/\/shop_images\/logo_Axis_One_cuadrado.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"f163e834-e097-4d95-90ed-e5dbc473a25c":{"type":"image-with-text","blocks":{"1ac84157-4a75-4ebd-b8c9-729e4ac234f9":{"type":"heading","settings":{"heading":"Volumen de impresión","heading_size":"h2"}},"c1bafb4f-e32b-4fc5-9b06-d7622547204f":{"type":"text","settings":{"text":"<p>Un gran volumen de impresión 3D para que logres construir piezas de gran tamaño de una sola vez.<br\/><br\/>300 x 280 x 300 mm.<\/p>","text_style":"body"}}},"block_order":["1ac84157-4a75-4ebd-b8c9-729e4ac234f9","c1bafb4f-e32b-4fc5-9b06-d7622547204f"],"settings":{"image":"shopify:\/\/shop_images\/Axis_One_300_mm_al_cubo.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"ee84eaa6-ab41-4366-9979-d64ab1e531e6":{"type":"image-with-text","blocks":{"4f1350bc-3edd-4d7b-8d66-8736a6484d05":{"type":"heading","settings":{"heading":"Calibración Automática","heading_size":"h2"}},"8e82a851-0b2c-4de0-82c8-c8684304333b":{"type":"text","settings":{"text":"<p>Es un sistema pionero de monitoreo de la plataforma mediante inducción de impresión en la cual calcula y corrige las desviaciones de la base, con una sensibilidad de 10 micrones de precisión.<\/p>","text_style":"body"}}},"block_order":["4f1350bc-3edd-4d7b-8d66-8736a6484d05","8e82a851-0b2c-4de0-82c8-c8684304333b"],"settings":{"image":"shopify:\/\/shop_images\/Sensor_con_ondas.jpg","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"e304af65-a0d8-473f-9b55-468ca7873730":{"type":"image-with-text","blocks":{"ba839e49-7c76-4a86-aac0-54cb34a72283":{"type":"heading","settings":{"heading":"Filamentos Rígidos y Flexibles","heading_size":"h2"}},"404df6a7-0519-46f5-b860-3f879ac35174":{"type":"text","settings":{"text":"<p>Nuestras impresoras están hechas para ocupar filamentos rígidos y flexibles. Axis One es una de las pocas impresoras del mercado que podemos imprimir materiales flexibles.<br\/><\/p><p>Nuestros filamentos son Biodegradables, inocuos con los alimentos, No tóxicos en caso de ser ingeridos, no emiten olores al ser impresos. Todos nuestros filamentos están estandarizados para que tengas la mejor calidad y la máxima vida útil de la impresora 3D.<\/p><p><a href=\"\/products\/filamento_tpu\" target=\"_blank\" title=\"Filamento Flexible\">Los mejores Filamentos Flexibles aquí<\/a><\/p><p><a href=\"\/collections\/pla\" target=\"_blank\" title=\"Filamentos PLA ✔️\">Los mejores Filamentos PLA aquí<\/a><\/p>","text_style":"body"}}},"block_order":["ba839e49-7c76-4a86-aac0-54cb34a72283","404df6a7-0519-46f5-b860-3f879ac35174"],"settings":{"image":"shopify:\/\/shop_images\/Flexibles22.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"39d4d9a3-f728-4eda-97b6-13a779712a54":{"type":"image-with-text","blocks":{"8b28ebca-da9d-4384-ae39-47a068b1132e":{"type":"heading","settings":{"heading":"Padi","heading_size":"h2"}},"b351da78-47af-464f-90ed-e9286cab232a":{"type":"text","settings":{"text":"<p>Base de impresión flexible de fácil remoción de impresiones, con adhesión magnética y  comportamiento Termodependiente.<br\/><br\/><a href=\"\/products\/padi-superficie-de-impresion\" target=\"_blank\" title=\"Padi - Superficie de impresión\">Todas las Características del Padi aquí<\/a><\/p>","text_style":"body"}}},"block_order":["8b28ebca-da9d-4384-ae39-47a068b1132e","b351da78-47af-464f-90ed-e9286cab232a"],"settings":{"image":"shopify:\/\/shop_images\/Padi_-_Ligera.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"7dce772b-879d-4ef9-bc46-ff17691f7775":{"type":"image-with-text","blocks":{"bc66aad5-166d-404a-b248-57c08bec43c8":{"type":"heading","settings":{"heading":"Pantalla Táctil","heading_size":"h2"}},"face076b-2f00-4b56-868a-2bc8cd956c6a":{"type":"text","settings":{"text":"<p>La impresora Axis One cuenta con una pantalla TFT, en la cual, hemos trabajado para hacer el display cada vez más fácil e intuitivo de ocupar. Esta 3ra versión, en la cual incorporamos la capacidad de recibir los archivos de impresión gcodes directamente en la pantalla y cuenta con su propio sistema operativo.<\/p>","text_style":"body"}}},"block_order":["bc66aad5-166d-404a-b248-57c08bec43c8","face076b-2f00-4b56-868a-2bc8cd956c6a"],"settings":{"image":"shopify:\/\/shop_images\/Pantalla2.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"60f43ed1-504b-4acb-a9b8-ea57b5ae63f2":{"type":"image-with-text","blocks":{"0e5d0175-2a7b-400e-9d3f-76d02e676256":{"type":"heading","settings":{"heading":"MCE","heading_size":"h2"}},"83f99ec6-4ae9-440f-947c-ecb19dae2fd1":{"type":"text","settings":{"text":"<p>La Impresora 3D Axis One cuenta con Memoria de Corte de Energía, la cual guarda el ultimo comando de ejecución. Entonces, cuando se corte la energía, al volver la corriente, te preguntará si deseas continuar la impresión.<\/p>","text_style":"body"}}},"block_order":["0e5d0175-2a7b-400e-9d3f-76d02e676256","83f99ec6-4ae9-440f-947c-ecb19dae2fd1"],"settings":{"image":"shopify:\/\/shop_images\/Chip_electrico.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"9666c9a3-7cfa-46af-834b-de42da28d3b4":{"type":"image-with-text","blocks":{"a5313c8c-a35c-481d-bb07-e12ad279b51d":{"type":"heading","settings":{"heading":"Alta Resolución","heading_size":"h2"}},"d91673b2-9cfd-448a-85cc-47c3bceef84b":{"type":"text","settings":{"text":"<p>La Impresora 3D Axis One puede otorgarle una resolución de 100 micrometros (0,1 mm) en la altura de capa, y de 10 micrometros (0,01 mm) en horizontal XY.<\/p>","text_style":"body"}}},"block_order":["a5313c8c-a35c-481d-bb07-e12ad279b51d","d91673b2-9cfd-448a-85cc-47c3bceef84b"],"settings":{"image":"shopify:\/\/shop_images\/impresion_3D_4.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"34ad6842-9f5a-4012-8cdc-8ac84143a194":{"type":"image-with-text","blocks":{"c57a5446-fd54-4e25-ad48-c8e6d9780dc5":{"type":"heading","settings":{"heading":"Separación de corrientes","heading_size":"h2"}},"7ff1f0d8-bc30-480d-b275-d27fc07759b1":{"type":"text","settings":{"text":"<p>La separación de corrientes de <strong>alta<\/strong> y <strong>baja <\/strong>potencia es para lograr calentar la base y el extrusor de manera muy rápida sin afectar a la placa electrónica que controla la maquina.<\/p>","text_style":"body"}}},"block_order":["c57a5446-fd54-4e25-ad48-c8e6d9780dc5","7ff1f0d8-bc30-480d-b275-d27fc07759b1"],"settings":{"image":"shopify:\/\/shop_images\/electricidad_rayo2.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"fc159a04-1362-473c-ba36-4450060e8992":{"type":"image-with-text","blocks":{"7c9c4590-17c2-4ee6-99a5-691ba3461105":{"type":"heading","settings":{"heading":"Protección Electrica","heading_size":"h2"}},"165bd0c8-a761-40e5-ac20-b13230b8a9f5":{"type":"text","settings":{"text":"<p>En caso de alzas o bajas de energía, la impresora cuenta con un sistema que la protege en caso de que ocurra esta variaciones en el voltaje y no permite que afecte a los componentes externos.<\/p>","text_style":"body"}}},"block_order":["7c9c4590-17c2-4ee6-99a5-691ba3461105","165bd0c8-a761-40e5-ac20-b13230b8a9f5"],"settings":{"image":"shopify:\/\/shop_images\/escudo.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"6223ea64-5002-4673-9eab-064f2c304ffa":{"type":"image-with-text","blocks":{"4a6c08bb-5b83-4a3c-aa7a-f3345a39655b":{"type":"heading","settings":{"heading":"Soporte Técnico Total","heading_size":"h2"}},"f4e74cc2-6319-4a0b-b2ce-e16db522fb7c":{"type":"text","settings":{"text":"<p>Al ser diseñadas y fabricadas en Chile, por nosotros, <strong>Print3x <\/strong>(Crea 3D SpA), contamos con un stock completo de piezas, además de tener el knowhow del porqué de las partes, para proporcionarle una reparación completa y otorgarle la máxima calidad en nuestros productos.<\/p>","text_style":"body"}}},"block_order":["4a6c08bb-5b83-4a3c-aa7a-f3345a39655b","f4e74cc2-6319-4a0b-b2ce-e16db522fb7c"],"settings":{"image":"shopify:\/\/shop_images\/reparacion2.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"3e1f5058-f734-4900-ad6a-abae33308d46":{"type":"image-with-text","blocks":{"35d70256-8148-46e3-bdc5-b92bced7d45b":{"type":"heading","settings":{"heading":"Software propio","heading_size":"h2"}},"d577a844-2573-4003-bd3f-567669a21857":{"type":"text","settings":{"text":"<p>Utilizamos un <strong>software propio<\/strong> que junto con la comunidad vamos mejorando generación tras generación.<\/p><p><\/p><p>El <strong>Software Slic3r<\/strong> lo tenemos configurado y una vez instalado, esta listo para usar.<\/p><p><\/p><p>Te avisamos por mail para que descargues la <strong>última versión <\/strong>de nuestras configuraciones.<\/p>","text_style":"body"}}},"block_order":["35d70256-8148-46e3-bdc5-b92bced7d45b","d577a844-2573-4003-bd3f-567669a21857"],"settings":{"image":"shopify:\/\/shop_images\/Slic3r_3.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"25dbdbbc-e19a-4325-ad38-0bf5a9b8ce8b":{"type":"image-with-text","blocks":{"9648b3ec-c364-4a25-be80-ca64dede642b":{"type":"heading","settings":{"heading":"S.O.C.","heading_size":"h2"}},"f3c701df-2dde-4173-a02a-56e4752b1e54":{"type":"text","settings":{"text":"<p>La impresora 3D cuenta con <strong>Sistemas Ópticos de Contactos<\/strong>, los cuales evitan que haya contacto cuando la impresora hace homming, evitando el desgaste de piezas criticas.<\/p><p>Las partes interrumpen una luz infrarroja y con ello la maquina sabe donde están las partes mobiles.<\/p>","text_style":"body"}}},"block_order":["9648b3ec-c364-4a25-be80-ca64dede642b","f3c701df-2dde-4173-a02a-56e4752b1e54"],"settings":{"image":"shopify:\/\/shop_images\/OptoSensor4.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"010cb042-8b45-40f2-82af-50090f963658":{"type":"image-with-text","blocks":{"a9c217f0-76b9-4bff-a62f-a58b81399956":{"type":"heading","settings":{"heading":"Tensores regulables","heading_size":"h2"}},"2989a563-73ea-40af-886a-620814724c70":{"type":"text","settings":{"text":"<p>Con el tiempo las maquinas sufren desgaste y para ello tenemos unas partes que el usuario a los meses de uso puede ir <strong>regulando <\/strong>para controlar la tensión en las correas de la maquina, con el fin de que obtengas los mejores resultados. ;)<\/p>","text_style":"body"}}},"block_order":["a9c217f0-76b9-4bff-a62f-a58b81399956","2989a563-73ea-40af-886a-620814724c70"],"settings":{"image":"shopify:\/\/shop_images\/Tensor3.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"92a7c0b2-dd81-4628-b022-19af4e740fb5":{"type":"image-with-text","blocks":{"b2461ded-278a-4c5e-8ba6-89d92b4b5439":{"type":"heading","settings":{"heading":"Velocidades de impresión","heading_size":"h2"}},"df6dd0e1-9144-4a08-8df5-09ca82e3b178":{"type":"text","settings":{"text":"<p>La impresora se mueve a una velocidad de 85 mm\/s cuando esta extrayendo y a 167 mm\/s cuando no esta imprimiendo, en los saltos de posición.<br\/><br\/>Esto la posiciona como una de las más rápidas de su categoría. <\/p>","text_style":"body"}}},"block_order":["b2461ded-278a-4c5e-8ba6-89d92b4b5439","df6dd0e1-9144-4a08-8df5-09ca82e3b178"],"settings":{"image":"shopify:\/\/shop_images\/rapidez-2.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-2","image_behavior":"none","mobile_content_alignment":"left","padding_top":20,"padding_bottom":0}},"3d3ef2e7-cb97-42c5-af62-46d96b222383":{"type":"image-with-text","blocks":{"58a5889c-47a8-4750-909b-c5e335b6f1a5":{"type":"heading","settings":{"heading":"Capacitaciones","heading_size":"h2"}},"aeee4281-f41a-4ce1-aaa0-df1106c37eae":{"type":"text","settings":{"text":"<p>La compra de la Axis One incluye una capacitación presencial en el uso y mantención de la impresora 3D.<br\/><br\/>También contamos con las capacitaciones online en la cual entregamos la mayoría de nuestros secretos y tips para que sepas como sacar el maximo provecho a tu impresora 3D, Y contamos con las capacitaciones de nivel usuario y profesionales.<\/p>","text_style":"body"}}},"block_order":["58a5889c-47a8-4750-909b-c5e335b6f1a5","aeee4281-f41a-4ce1-aaa0-df1106c37eae"],"settings":{"image":"