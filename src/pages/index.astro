---
import SiteLayout from '../layouts/SiteLayout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import { indexMedia } from '../data/index-media';

const slides = [
  {
    media: indexMedia.hero1,
    heading: 'Filamentos para Impresión 3D',
    subheading: '',
    href: '/collections/pla',
    buttonLabel: 'Ver colección',
    alignment: 'middle-left',
    textAlignment: 'left',
    mobileTextAlignment: 'left',
    colorScheme: 'background-2',
    width: indexMedia.hero1.width,
    height: indexMedia.hero1.height,
  },
  {
    media: indexMedia.hero2,
    heading: 'Aprender Impresión 3D',
    subheading: '',
    href: '/blogs/curso_impresion_3d',
    buttonLabel: 'Ir 😎',
    alignment: 'middle-center',
    textAlignment: 'center',
    mobileTextAlignment: 'center',
    colorScheme: 'background-1',
    width: indexMedia.hero2.width,
    height: indexMedia.hero2.height,
  },
  {
    media: indexMedia.hero3,
    heading: 'Filamentos Impresión 3D',
    subheading: '',
    href: '/collections/pla',
    buttonLabel: 'Ver colección',
    alignment: 'middle-right',
    textAlignment: 'left',
    mobileTextAlignment: 'left',
    colorScheme: 'background-2',
    width: indexMedia.hero3.width,
    height: indexMedia.hero3.height,
  },
  {
    media: indexMedia.hero4,
    heading: 'Impresora 3D',
    subheading: 'Impresora 3D profesional Axis One',
    href: '/products/axis-one',
    buttonLabel: 'Ver impresora',
    alignment: 'middle-center',
    textAlignment: 'center',
    mobileTextAlignment: 'left',
    colorScheme: 'background-2',
    width: indexMedia.hero4.width,
    height: indexMedia.hero4.height,
  },
] as const;

const commitments = [
  { label: 'Filamentos Estandarizados', media: indexMedia.compromisoCarreteFilamento },
  { label: 'Color Homogéneo en los filamentos', media: indexMedia.compromisoImpresion3d },
  { label: 'Te ayudamos con tips para mejorar', media: indexMedia.compromisoLineaMeta },
  { label: 'Cualquier problema nos avisas y respondemos', media: indexMedia.compromisoPulgarArriba },
] as const;
---

<SiteLayout
  title="Filamentos PLA Print3x e Impresoras 3D profesionales ✔️"
  description="Filamentos PLA Print3x e Impresoras 3D profesionales."
>
  <article class="homepage">
    <h1 class="visually-hidden">Filamentos PLA Print3x e Impresoras 3D profesionales</h1>
    <section
      class="homepage__slideshow slideshow banner banner--medium banner--mobile-bottom color-background-2"
      data-p3x-slider
      data-p3x-slider-mode="slideshow"
      data-p3x-slider-loop="true"
      data-p3x-slider-keyboard="true"
      data-p3x-slider-autoplay="5000"
      aria-label="Slideshow about our brand"
      tabindex="0"
    >
      <div id="homepage-slides" class="homepage__slides" aria-live="polite" aria-atomic="true">
        {slides.map((slide, index) => (
          <div
            class:list={[
              'homepage__slide',
              'slideshow__slide',
              'grid__item',
              'grid--1-col',
              'slider__slide',
              `color-${slide.colorScheme}`,
            ]}
            data-p3x-slide
            data-p3x-slide-active={index === 0 ? true : undefined}
            aria-hidden={index === 0 ? 'false' : 'true'}
            aria-label={`${index + 1} / ${slides.length}`}
            role="group"
          >
            <div class="homepage__slide-media banner__media media">
              <MediaPlaceholder
                media={slide.media}
                width={slide.width}
                height={slide.height}
                class="homepage__slide-placeholder"
                loading="eager"
                fetchpriority={index === 0 ? 'high' : undefined}
              />
            </div>
            <div class:list={['homepage__slide-content', 'banner__content', `banner__content--${slide.alignment}`, 'page-width']}>
              <div class:list={['homepage__slide-box', 'slideshow__text', 'banner__box', 'content-container', 'gradient', `slideshow__text--${slide.textAlignment}`, `slideshow__text-mobile--${slide.mobileTextAlignment}`]}>
                <h2 class="banner__heading inline-richtext h2">{slide.heading}</h2>
                {slide.subheading && (
                  <div class="banner__text rte">
                    <p>{slide.subheading}</p>
                  </div>
                )}
                <div class="banner__buttons">
                  <a class="button button--secondary" href={slide.href}>{slide.buttonLabel}</a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="homepage__slider-controls slideshow__controls slider-buttons" aria-label="Controles del slideshow">
        <button type="button" class="slider-button slider-button--prev" data-p3x-slider-prev aria-label="Slide anterior">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="slider-counter slider-counter--dots visually-hidden" data-p3x-slider-status>
          <span>Slide actual: 1 / {slides.length}</span>
        </div>
        <div class="homepage__slider-dots" aria-label="Seleccionar slide">
          {slides.map((_, index) => (
            <button
              type="button"
              class="slider-counter__link slider-counter__link--dots"
              data-p3x-slider-to={index}
              aria-label={`Ir al slide ${index + 1} de ${slides.length}`}
              aria-controls="homepage-slides"
            >
              <span class="dot" aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <button type="button" class="slider-button slider-button--next" data-p3x-slider-next aria-label="Slide siguiente">
          <span aria-hidden="true">›</span>
        </button>
        <button
          type="button"
          class="slideshow__autoplay slider-button"
          data-p3x-slider-toggle
          data-p3x-slider-pause-label="Pausar slideshow"
          data-p3x-slider-resume-label="Reanudar slideshow"
          aria-label="Pausar slideshow"
          aria-pressed="false"
        >
          <svg class="icon icon-pause" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
            <path d="M1.2 0.75C0.813401 0.75 0.5 0.985051 0.5 1.275V10.725C0.5 11.0149 0.813401 11.25 1.2 11.25C1.5866 11.25 1.9 11.0149 1.9 10.725V1.275C1.9 0.985051 1.5866 0.75 1.2 0.75Z" fill="currentColor" />
            <path d="M6.8 0.75C6.4134 0.75 6.1 0.985051 6.1 1.275V10.725C6.1 11.0149 6.4134 11.25 6.8 11.25C7.1866 11.25 7.5 11.0149 7.5 10.725V1.275C7.5 0.985051 7.1866 0.75 6.8 0.75Z" fill="currentColor" />
          </svg>
          <svg class="icon icon-play" viewBox="0 0 10 14" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M1.48177 0.814643C0.81532 0.448245 0 0.930414 0 1.69094V12.2081C0 12.991 0.858787 13.4702 1.52503 13.0592L10.5398 7.49813C11.1918 7.09588 11.1679 6.13985 10.4965 5.77075L1.48177 0.814643Z" fill="currentColor" />
          </svg>
          <span class="visually-hidden" data-p3x-slider-toggle-label>Pausar slideshow</span>
        </button>
      </div>
    </section>

    <section class="homepage__section homepage__collections page-width" aria-labelledby="homepage-collections-title">
      <div class="homepage__section-heading">
        <h2 id="homepage-collections-title">Categorías de nuestros productos</h2>
      </div>
      <div class="homepage__collection-grid">
        <a class="homepage__collection-card" href="/collections/pla">
          <MediaPlaceholder
            media={indexMedia.categoriasFilamentosPla}
            width={indexMedia.categoriasFilamentosPla.width}
            height={indexMedia.categoriasFilamentosPla.height}
            class="homepage__collection-media"
            loading="lazy"
            sizes="(min-width: 750px) 50vw, 100vw"
          />
          <h3>Filamentos PLA ✔️</h3>
        </a>
        <a class="homepage__collection-card" href="/collections/impresoras-3d">
          <MediaPlaceholder
            media={indexMedia.categoriasImpresora3d}
            width={indexMedia.categoriasImpresora3d.width}
            height={indexMedia.categoriasImpresora3d.height}
            class="homepage__collection-media"
            loading="lazy"
            sizes="(min-width: 750px) 50vw, 100vw"
          />
          <h3>Impresoras 3D y superficies</h3>
        </a>
      </div>
    </section>

    <section class="homepage__commitments color-inverse" aria-labelledby="homepage-commitments-title">
      <div class="page-width">
        <h2 id="homepage-commitments-title">Nuestros Compromisos</h2>
        <ul class="homepage__commitment-grid" role="list">
          {commitments.map(({ label, media }) => (
            <li class="homepage__commitment">
              <MediaPlaceholder
                media={media}
                width={media.width}
                height={media.height}
                class="homepage__commitment-media"
                loading="lazy"
                sizes="150px"
              />
              <h3>{label}</h3>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</SiteLayout>
