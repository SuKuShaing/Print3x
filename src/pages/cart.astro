---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Tu carrito – Print3x"
  socialDescription="El escaparate histórico de Print3x no mantiene un carrito activo ni ofrece proceso de compra."
  noIndex
>
  <section class="controlled-route page-width page-margin" aria-labelledby="cart-title">
    <div class="controlled-route__panel">
      <h1 id="cart-title">Tu carrito está vacío</h1>
      <p>Este escaparate histórico no mantiene un carrito activo ni ofrece proceso de compra.</p>
      <p class="controlled-route__notice">
        Puedes seguir recorriendo el contenido disponible de Print3x.
      </p>
      <a class="button" href="/">Volver al inicio</a>
    </div>
  </section>
</SiteLayout>
