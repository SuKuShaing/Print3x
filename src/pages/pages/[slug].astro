---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import NosotrosPage from '../../components/NosotrosPage.astro';
import PremiosPage from '../../components/PremiosPage.astro';
import MejorFilamentoPage from '../../components/MejorFilamentoPage.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.data.slug },
    props: { page },
  }));
}

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props as Props;
const { Content } = await render(page);
const { data } = page;
const siteBase = Astro.site ?? Astro.url;
const homeUrl = new URL('/', siteBase).toString();
const pageUrl = new URL(`/pages/${data.slug}`, siteBase).toString();
const isAboutPage = data.slug === 'nosotros';
---

<SiteLayout
  title={data.seo?.title ?? `${data.title} – Print3x`}
  description={data.seo?.description}
  noIndex={data.seo?.noIndex ?? false}
  sourceUrl={data.sourceUrl}
  sourceRetrieved={data.sourceRetrieved}
  pageType={isAboutPage ? 'AboutPage' : 'WebPage'}
  breadcrumbs={[
    { name: 'Inicio', url: homeUrl },
    { name: data.title, url: pageUrl },
  ]}
>
  {data.slug === 'nosotros' ? <NosotrosPage /> : data.slug === 'premios' ? <PremiosPage title={data.title} /> : data.slug === 'como-determinar-cual-es-el-mejor-filamento-pla' ? <MejorFilamentoPage /> : <article class="editorial-page page-width">
    <header class="editorial-page__header">
      <p class="editorial-page__eyebrow">Print3x</p>
      <h1>{data.title}</h1>
    </header>
    <div class="editorial-page__body rte">
      <Content />
    </div>
  </article>}
</SiteLayout>
