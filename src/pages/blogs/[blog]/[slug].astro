---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { absoluteImageUrl, articleSchema } from '../../../data/structured-data';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import MeshmixerArticle from '../../../components/MeshmixerArticle.astro';
import OpenScadArticle from '../../../components/OpenScadArticle.astro';
import RepetierHostArticle from '../../../components/RepetierHostArticle.astro';
import CalibrationArticle from '../../../components/CalibrationArticle.astro';
import meshmixerPoster from '../../../assets/index-blogs-meshmixer/Miniatura 1.jpg';
import openScadPoster from '../../../assets/index-blogs-openscad/openscad.jpg';
import repetierPoster from '../../../assets/index-blogs-curso_impresion_3d-configurar-repetier-host/configurar repetier host.jpg';
import calibrationPoster from '../../../assets/index-blogs-calibración_automatica/miniatura 1.jpg';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { blog: article.data.blog, slug: article.data.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props as Props;
const { Content } = await render(article);
const { data } = article;
const blogs = await getCollection('blogs');
const parentBlog = blogs.find((blog) => blog.data.slug === data.blog);
const isMeshmixer = data.slug === 'meshmixer';
const isOpenScad = data.slug === 'openscad';
const isRepetierHost = data.slug === 'configurar-repetier-host';
const isCalibration = data.slug === 'impresion_3d_calibracion_automatica';
const articlePosters: Record<string, ImageMetadata> = {
  meshmixer: meshmixerPoster,
  openscad: openScadPoster,
  'configurar-repetier-host': repetierPoster,
  impresion_3d_calibracion_automatica: calibrationPoster,
};
const siteBase = Astro.site ?? Astro.url;
const homeUrl = new URL('/', siteBase).toString();
const blogUrl = new URL(`/blogs/${data.blog}`, siteBase).toString();
const articleUrl = new URL(`/blogs/${data.blog}/${data.slug}`, siteBase).toString();
const articleId = `${articleUrl}#article`;
const articleStructuredData = articleSchema({
  url: articleUrl,
  headline: data.title,
  description: data.seo?.description,
  image: articlePosters[data.slug] ? absoluteImageUrl(articlePosters[data.slug], siteBase) : undefined,
  keywords: data.tags,
  section: parentBlog?.data.title,
  siteBase,
});
const socialDescription = data.seo?.description
  ?? `Guía de ${data.title} dentro del curso de impresión 3D de Print3x.`;
---

<SiteLayout
  title={data.seo?.title ?? `${data.title} – Print3x`}
  description={data.seo?.description}
  socialImage={articlePosters[data.slug]}
  socialDescription={socialDescription}
  noIndex={data.seo?.noIndex ?? false}
  sourceUrl={data.sourceUrl}
  sourceRetrieved={data.sourceRetrieved}
  mainEntityId={articleId}
  breadcrumbs={[
    { name: 'Inicio', url: homeUrl },
    { name: parentBlog?.data.title ?? data.blog, url: blogUrl },
    { name: data.title, url: articleUrl },
  ]}
  structuredData={[articleStructuredData]}
>
  <article class:list={[isMeshmixer ? 'meshmixer-article-page' : isOpenScad ? 'openscad-article-page' : isRepetierHost ? 'repetier-host-article-page' : isCalibration ? 'calibration-article-page' : 'editorial-page editorial-article page-width']}>
    {isMeshmixer ? (
      <MeshmixerArticle />
    ) : isOpenScad ? (
      <OpenScadArticle />
    ) : isRepetierHost ? (
      <RepetierHostArticle />
    ) : isCalibration ? (
      <CalibrationArticle />
    ) : (
      <>
        <header class="editorial-page__header">
          <p class="editorial-page__eyebrow"><a href={`/blogs/${data.blog}`}>{data.blog}</a></p>
          <h1>{data.title}</h1>
        </header>
        <div class="editorial-page__body rte">
          <Content />
        </div>
        <p class="editorial-article__back"><a href={`/blogs/${data.blog}`}>Regresar al blog</a></p>
      </>
    )}
  </article>
</SiteLayout>

<style>
  .repetier-host-article-page {
    padding: 0;
  }
</style>
