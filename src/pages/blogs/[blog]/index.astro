---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { itemListSchema } from '../../../data/structured-data';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import repetierPoster from '../../../assets/index-blogs-curso_impresion_3d-configurar-repetier-host/configurar repetier host.jpg';
import openScadPoster from '../../../assets/index-blogs-openscad/openscad.jpg';
import meshmixerPoster from '../../../assets/index-blogs-meshmixer/Miniatura 1.jpg';
import calibrationPoster from '../../../assets/index-blogs-calibración_automatica/miniatura 1.jpg';

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  return blogs.map((blog) => ({
    params: { blog: blog.data.slug },
    props: { blog },
  }));
}

interface Props {
  blog: CollectionEntry<'blogs'>;
}

const { blog } = Astro.props as Props;
const { data } = blog;
const articleMedia: Record<string, ImageMetadata> = {
  'configurar-repetier-host': repetierPoster,
  openscad: openScadPoster,
  meshmixer: meshmixerPoster,
  impresion_3d_calibracion_automatica: calibrationPoster,
};
const firstArticleImage = data.articles
  .map((article) => articleMedia[article.slug])
  .find((image) => Boolean(image));
const siteBase = Astro.site ?? Astro.url;
const homeUrl = new URL('/', siteBase).toString();
const blogUrl = new URL(`/blogs/${data.slug}`, siteBase).toString();
const itemListId = `${blogUrl}#articles`;
const articlesSchema = itemListSchema({
  id: itemListId,
  name: data.title,
  items: data.articles.map((article) => ({
    name: article.title,
    url: new URL(`/blogs/${data.slug}/${article.slug}`, siteBase).toString(),
  })),
});
---

<SiteLayout
  title={data.seo?.title ?? `${data.title} – Print3x`}
  description={data.seo?.description}
  socialImage={firstArticleImage}
  socialDescription={data.seo?.description ?? `Contenido del blog ${data.title} de Print3x.`}
  noIndex={data.seo?.noIndex ?? false}
  sourceUrl={data.sourceUrl}
  sourceRetrieved={data.sourceRetrieved}
  pageType="CollectionPage"
  mainEntityId={itemListId}
  breadcrumbs={[
    { name: 'Inicio', url: homeUrl },
    { name: data.title, url: blogUrl },
  ]}
  structuredData={[articlesSchema]}
>
   <div class="main-blog page-width">
    <h1 class="title--primary">{data.title}</h1>

    <div class="blog-articles">
      {data.articles.map((article) => {
        const poster = articleMedia[article.slug];

        return (
          <div class="blog-articles__article article">
            <div class="article-card-wrapper card-wrapper underline-links-hover">
              <div class="card article-card card--card article-card__image--medium card--media color-background-2 gradient">
                <div class="card__inner ratio" style="--ratio-percent: 56.25%;">
                  <div class="article-card__image-wrapper card__media">
                    <div class="article-card__image media media--hover-effect">
                      {poster ? (
                        <Picture
                          src={poster}
                          formats={['avif', 'webp']}
                          widths={[360, 533, 720, 1000, 1500]}
                          sizes="(min-width: 1200px) 550px, (min-width: 750px) calc((100vw - 130px) / 2), calc(100vw - 50px)"
                          alt={article.title}
                          loading="lazy"
                        />
                      ) : (
                        <div class="media-placeholder media-placeholder--pending" data-media-status="pending" aria-hidden="true"></div>
                      )}
                    </div>
                  </div>
                  <div class="card__content">
                    <div class="card__information">
                      <h2 class="card__heading">{article.title}</h2>
                    </div>
                  </div>
                </div>
                <div class="card__content">
                  <div class="card__information">
                    <h2 class="card__heading">
                      <a href={`/blogs/${data.slug}/${article.slug}`} class="full-unstyled-link">
                        {article.title}
                      </a>
                    </h2>
                    {article.description && <p class="article-card__excerpt rte-width">{article.description}</p>}
                    <div class="article-card__footer"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</SiteLayout>
