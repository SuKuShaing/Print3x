---
import { getCollection } from 'astro:content';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import { indexMedia } from '../../data/index-media';
import { itemListSchema } from '../../data/structured-data';
import SiteLayout from '../../layouts/SiteLayout.astro';

const collections = await getCollection('collections');
const collectionOrder = ['pla', 'impresoras-3d'];
const collectionsBySlug = new Map(collections.map((collection) => [collection.data.slug, collection]));
const orderedCollections = collectionOrder.flatMap((slug) => {
  const collection = collectionsBySlug.get(slug);
  return collection ? [collection] : [];
});
const siteBase = Astro.site ?? Astro.url;
const homeUrl = new URL('/', siteBase).toString();
const collectionsUrl = new URL('/collections', siteBase).toString();
const itemListId = `${collectionsUrl}#collections`;
const collectionsSchema = itemListSchema({
  id: itemListId,
  name: 'Colecciones de Print3x',
  items: orderedCollections.map((collection) => ({
    name: collection.data.title,
    url: new URL(`/collections/${collection.data.slug}`, siteBase).toString(),
  })),
});
---

<SiteLayout
  title="Colecciones – Print3x"
  socialImage={indexMedia.categoriasFilamentosPla.src}
  socialDescription="Explora las colecciones de filamentos PLA, impresoras 3D y superficies de Print3x."
  pageType="CollectionPage"
  mainEntityId={itemListId}
  breadcrumbs={[
    { name: 'Inicio', url: homeUrl },
    { name: 'Colecciones', url: collectionsUrl },
  ]}
  structuredData={[collectionsSchema]}
>
  <article class="collection-page page-width">
    <header class="collection-page__header">
      <p class="collection-page__eyebrow">Print3x</p>
      <h1>Colecciones</h1>
    </header>
    <div class="collection-page__grid collection-page__grid--collections">
      {orderedCollections.map((collection) => (
        <a class="collection-product-card" href={`/collections/${collection.data.slug}`}>
          <MediaPlaceholder
            media={collection.data.slug === 'pla' ? indexMedia.categoriasFilamentosPla : indexMedia.categoriasImpresora3d}
            width={collection.data.slug === 'pla' ? indexMedia.categoriasFilamentosPla.width : indexMedia.categoriasImpresora3d.width}
            height={collection.data.slug === 'pla' ? indexMedia.categoriasFilamentosPla.height : indexMedia.categoriasImpresora3d.height}
            class="collection-index__media"
            sizes="(min-width: 750px) 50vw, 100vw"
          />
          <span class="collection-product-card__title">{collection.data.title}</span>
        </a>
      ))}
    </div>
  </article>
</SiteLayout>
