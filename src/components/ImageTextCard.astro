---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  year?: string;
  title?: string;
  content?: string | readonly string[];
  html?: string;
  links?: readonly { href: string; label: string }[];
  reverse?: boolean;
  breakBeforeContent?: readonly number[];
  imageFit?: 'cover' | 'contain';
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  image,
  alt,
  year,
  title,
  content,
  html,
  links = [],
  reverse = false,
  breakBeforeContent = [],
  imageFit = 'cover',
  loading = 'lazy',
  class: className,
} = Astro.props;

const paragraphs = typeof content === 'string' ? [content] : content ?? [];
---

<section class:list={['image-text-card', className]}>
  <div class="image-with-text image-with-text--no-overlap page-width isolate collapse-corners">
    <div class:list={[
      'image-with-text__grid',
      'grid',
      'grid--gapless',
      'grid--1-col',
      'grid--2-col-tablet',
      reverse && 'image-with-text__grid--reverse',
    ]}>
      <div class="image-with-text__media-item image-with-text__media-item--medium grid__item">
        <div class:list={[
          'image-with-text__media',
          'image-with-text__media--adapt',
          'global-media-settings',
          'media',
          imageFit === 'contain' && 'image-with-text__media--contain',
        ]} style={`padding-bottom: ${(image.height / image.width) * 100}%;`}>
          <Picture
            src={image}
            formats={['avif', 'webp']}
            widths={[375, 750, 1100, 1500]}
            sizes="(min-width: 1200px) 550px, (min-width: 750px) calc((100vw - 10rem) / 2), 100vw"
            alt={alt}
            width={1500}
            height={Math.round(1500 * image.height / image.width)}
            loading={loading}
          />
        </div>
      </div>
      <div class="image-with-text__text-item grid__item">
        <div class="image-with-text__content image-with-text__content--top image-with-text__content--desktop-left image-with-text__content--mobile-left image-with-text__content--adapt gradient color-background-2 content-container">
          {year && <p class="image-with-text__text image-with-text__text--caption caption-with-letter-spacing caption-with-letter-spacing--medium">{year}</p>}
          {title && <h2 class="image-with-text__heading inline-richtext h2">{title}</h2>}
          {html && <div class="image-with-text__text rte body" set:html={html} />}
          {!html && (paragraphs.length > 0 || links.length > 0) && <div class="image-with-text__text rte body">
            {paragraphs.map((paragraph, index) => (
              <p>{breakBeforeContent.includes(index) && <br />}{paragraph}</p>
            ))}
            {links.map((link) => <p><a href={link.href}>{link.label}</a></p>)}
          </div>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .image-text-card .image-with-text__media {
    min-height: 100%;
  }

  .image-text-card .image-with-text__media picture {
    display: block;
  }

  .image-text-card .image-with-text__media picture img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .image-text-card .image-with-text__media--contain picture img {
    object-fit: contain;
  }
</style>
