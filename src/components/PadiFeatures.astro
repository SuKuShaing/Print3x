---
import ImageTextCard from './ImageTextCard.astro';
import type { PadiProductDetails } from '../data/padi-product';

interface Props {
  details: PadiProductDetails;
}

const { details } = Astro.props;
---

<section class="padi-content" aria-labelledby="PadiFeaturesHeading">
  <div class="padi-content__intro color-accent-2 gradient">
    <header class="padi-content__heading page-width">
      <h2 id="PadiFeaturesHeading">{details.heading}</h2>
    </header>
  </div>

  {details.features.map((feature, index) => (
    <ImageTextCard
      image={feature.image.src}
      alt={feature.image.alt ?? ''}
      title={feature.heading}
      content={feature.paragraphs}
      links={feature.links}
      reverse={index % 2 === 1}
      imageFit={index === 0 ? 'contain' : 'cover'}
      loading={index < 2 ? 'eager' : 'lazy'}
      class="padi-feature"
    />
  ))}
</section>
