---
import { Picture } from 'astro:assets';
import 'lite-youtube-embed/src/lite-yt-embed.css';
import type { ImageMetadata } from 'astro';

interface Props {
  videoId: string;
  title: string;
  class?: string;
  poster?: ImageMetadata;
}

const { videoId, title, class: className, poster } = Astro.props;
const posterUrl = poster
  ? 'none'
  : `url("https://i.ytimg.com/vi/${encodeURIComponent(videoId)}/hqdefault.jpg")`;
---

<lite-youtube
  class={className}
  videoid={videoId}
  title={title}
  playlabel={`Reproducir: ${title}`}
  params="rel=0"
  style={`background-image: ${posterUrl}`}
>
  {poster && (
    <span class="lite-youtube__poster" aria-hidden="true">
      <Picture
        src={poster}
        formats={['avif', 'webp']}
        widths={[375, 750, 1100]}
        sizes="100vw"
        alt=""
        loading="lazy"
      />
    </span>
  )}
</lite-youtube>

<style>
  lite-youtube > .lite-youtube__poster {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity 180ms ease;
  }

  lite-youtube > .lite-youtube__poster img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  lite-youtube > .lite-youtube__poster picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  lite-youtube.lyt-activated > .lite-youtube__poster {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  import 'lite-youtube-embed/src/lite-yt-embed.js';
</script>
