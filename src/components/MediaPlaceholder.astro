---
import { Picture } from 'astro:assets';
import type { MediaReference } from '../data/types';

interface Props {
  media: MediaReference;
  /** Expected block dimensions are required for null and pending media. */
  width: number;
  height: number;
  class?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'auto' | 'sync';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: number[];
}

const {
  media,
  width,
  height,
  class: className,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  sizes = '100vw',
  widths,
} = Astro.props;

const mediaWidth = media?.width ?? width;
const mediaHeight = media?.height ?? height;
const mediaStatus = media?.status ?? 'pending';
const mediaClass = mediaStatus === 'available'
  ? 'media-placeholder--available'
  : 'media-placeholder--pending';
const ratioStyle = `--media-placeholder-ratio: ${mediaWidth} / ${mediaHeight};`;
const responsiveWidths = (widths ?? [390, 768, 1024, 1440])
  .filter((candidate, index, values) => candidate <= mediaWidth && values.indexOf(candidate) === index)
  .sort((a, b) => a - b);
if (responsiveWidths.length === 0) {
  responsiveWidths.push(mediaWidth);
}
const pictureWidth = responsiveWidths[responsiveWidths.length - 1] ?? mediaWidth;
const pictureHeight = Math.round(pictureWidth * mediaHeight / mediaWidth);
const fallbackFormat = media?.status === 'available' && ['jpeg', 'jpg'].includes(media.src.format)
  ? media.src.format
  : 'png';
---

<div
  class:list={['media-placeholder', mediaClass, className]}
  data-media-status={mediaStatus}
  data-media-width={mediaWidth}
  data-media-height={mediaHeight}
  style={ratioStyle}
  aria-hidden={mediaStatus === 'pending' ? 'true' : undefined}
>
  {media?.status === 'available' && (
    <Picture
      src={media.src}
      formats={['avif', 'webp']}
      fallbackFormat={fallbackFormat}
      widths={responsiveWidths}
      sizes={sizes}
      alt={media.alt ?? ''}
      width={pictureWidth}
      height={pictureHeight}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      class="media-placeholder__image"
      pictureAttributes={{ class: 'media-placeholder__picture' }}
    />
  )}
</div>
