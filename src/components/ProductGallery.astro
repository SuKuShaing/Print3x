---
import MediaPlaceholder from './MediaPlaceholder.astro';
import LiteYoutube from './LiteYoutube.astro';
import type { MediaReference, VideoMediaAsset } from '../data/types';

type ProductGalleryMedia = MediaReference | VideoMediaAsset;

interface Props {
  media: readonly ProductGalleryMedia[];
  title: string;
}

const { media, title } = Astro.props;
const mediaIds = media.map((_, index) => `product-media-${index + 1}`);
const isVideo = (item: ProductGalleryMedia): item is VideoMediaAsset => item?.status === 'video';
---

<div
  class="product-gallery"
  data-p3x-gallery
  data-p3x-gallery-display="carousel"
  data-p3x-gallery-active={mediaIds[0]}
  role="region"
  aria-label={`Visor de la galería de ${title}`}
  tabindex="0"
>
  <a class="skip-to-content-link visually-hidden product-gallery__skip" href="#ProductInfo">Ir directamente a la información del producto</a>

  <ul class="product-gallery__media-list" data-p3x-gallery-track role="list">
    {media.map((item, index) => {
      const mediaId = mediaIds[index];
      return (
        <li
          class="product-gallery__media-item"
          data-p3x-gallery-media={mediaId}
          data-p3x-gallery-active={index === 0 ? true : undefined}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <div class="product-gallery__media-frame">
            {isVideo(item) ? (
              <LiteYoutube videoId={item.videoId} title={item.title} class="product-gallery__video" />
            ) : (
              <MediaPlaceholder
                media={item}
                width={item?.width ?? 1000}
                height={item?.height ?? 1000}
                class="product-gallery__media-placeholder"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
                sizes="(min-width: 990px) 65vw, 100vw"
              />
            )}
            {item?.status === 'available' && (
            <button
              class="product-gallery__media-toggle"
              type="button"
              data-p3x-gallery-open
              data-p3x-gallery-target={mediaId}
              aria-haspopup="dialog"
            >
              <span class="visually-hidden">Abrir imagen {index + 1} en una ventana modal</span>
              <svg class="icon icon-zoom" width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M4.66724 7.93978C4.66655 7.66364 4.88984 7.43922 5.16598 7.43853L10.6996 7.42464C10.9758 7.42395 11.2002 7.64724 11.2009 7.92339C11.2016 8.19953 10.9783 8.42395 10.7021 8.42464L5.16849 8.43852C4.89235 8.43922 4.66793 8.21592 4.66724 7.93978Z" fill="currentColor" />
                <path fill-rule="evenodd" clip-rule="evenodd" d="M7.92576 4.66463C8.2019 4.66394 8.42632 4.88723 8.42702 5.16337L8.4409 10.697C8.44159 10.9732 8.2183 11.1976 7.94215 11.1983C7.66601 11.199 7.44159 10.9757 7.4409 10.6995L7.42702 5.16588C7.42633 4.88974 7.64962 4.66532 7.92576 4.66463Z" fill="currentColor" />
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12.8324 3.03011C10.1255 0.323296 5.73693 0.323296 3.03011 3.03011C0.323296 5.73693 0.323296 10.1256 3.03011 12.8324C5.73693 15.5392 10.1255 15.5392 12.8324 12.8324C15.5392 10.1256 15.5392 5.73693 12.8324 3.03011ZM2.32301 2.32301C5.42035 -0.774336 10.4421 -0.774336 13.5395 2.32301C16.6101 5.39361 16.6366 10.3556 13.619 13.4588L18.2473 18.0871C18.4426 18.2824 18.4426 18.599 18.2473 18.7943C18.0521 18.9895 17.7355 18.9895 17.5402 18.7943L12.8778 14.1318C9.76383 16.6223 5.20839 16.4249 2.32301 13.5395C-0.774335 10.4421 -0.774335 5.42035 2.32301 2.32301Z" fill="currentColor" />
              </svg>
            </button>
            )}
          </div>
        </li>
      );
    })}
  </ul>

  <div class="product-gallery__thumbnail-navigation">
    <div class="product-gallery__controls" aria-label="Controles de la galería">
      <button type="button" class="slider-button slider-button--prev" data-p3x-gallery-prev aria-label="Diapositiva anterior">
        <svg class="icon icon-caret product-gallery__caret--previous" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor" />
        </svg>
      </button>
      <div class="slider-counter caption" data-p3x-gallery-status role="status" aria-live="polite">
        1 / {media.length}
      </div>
      <button type="button" class="slider-button slider-button--next" data-p3x-gallery-next aria-label="Diapositiva siguiente">
        <svg class="icon icon-caret product-gallery__caret--next" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor" />
        </svg>
      </button>
    </div>

    <div class="product-gallery__thumbnail-slider">
      <ul class="product-gallery__thumbnail-list" role="list">
        {media.map((item, index) => {
          const mediaId = mediaIds[index];
          return (
            <li class="product-gallery__thumbnail-item">
              <button
                class="product-gallery__thumbnail"
                type="button"
                data-p3x-gallery-thumb
                data-p3x-gallery-target={mediaId}
                aria-current={index === 0 ? 'true' : 'false'}
                aria-label={`Cargar imagen ${index + 1} de ${media.length}`}
              >
                {isVideo(item) ? (
                  <span class="product-gallery__video-thumbnail" aria-hidden="true">
                    <MediaPlaceholder
                      media={item.poster ?? null}
                      width={item.poster?.width ?? 16}
                      height={item.poster?.height ?? 9}
                      loading="lazy"
                      sizes="(min-width: 990px) 15vw, 25vw"
                    />
                    <span class="product-gallery__video-play">▶</span>
                  </span>
                ) : (
                  <MediaPlaceholder
                    media={item}
                    width={200}
                    height={200}
                    loading="lazy"
                    sizes="(min-width: 990px) 15vw, 25vw"
                  />
                )}
              </button>
            </li>
          );
        })}
      </ul>
    </div>
  </div>

  <dialog class="product-gallery__modal" data-p3x-gallery-modal aria-label={`Galería de ${title}`}>
    <div class="product-gallery__modal-content" data-p3x-gallery-modal-content>
      <button class="product-gallery__modal-close" type="button" data-p3x-gallery-close aria-label="Cerrar">
        <span aria-hidden="true">×</span>
      </button>
    </div>
  </dialog>
</div>
